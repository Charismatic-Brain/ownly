# Ownly Backend Configuration
# development | test | production. Production refuses to start with weak or default secrets.
ENVIRONMENT=development
# MongoDB Connection
# Local:
# MONGODB_URI=mongodb://localhost:27017
#
# MongoDB Atlas (Cloud):
# Replace <username>, <password>, and <cluster-subdomain> with your Atlas cluster details.
# Note: If your password contains special characters like @, :, ?, #, percent-encode them.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=arkive

# Required in production: a unique random value, at least 32 characters.
#   openssl rand -hex 32
APP_SECRET_KEY=dev-insecure-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required in production: base64 of exactly 32 random bytes (encrypts stored files).
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# BACK THIS KEY UP SEPARATELY from the database - without it stored files are unrecoverable.
# In development it is derived from APP_SECRET_KEY when left empty.
FILE_ENCRYPTION_KEY=

FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/plain,application/json

# Session cookie (Secure is enabled automatically in production)
COOKIE_NAME=ownly_session
COOKIE_SAMESITE=lax

# Failed-login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_WINDOW_MINUTES=15
